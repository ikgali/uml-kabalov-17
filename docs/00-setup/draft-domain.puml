@startuml
!include ../../_style.puml
title Умный дом — черновик доменной модели
hide circle

class Пользователь {
  + имя : String
  + роль : Роль
  + привилегии : int
}

class Устройство {
  + id : String
  + тип : String
  + состояние : Состояние
}

class Датчик {
  + id : String
  + величина : String
  + последнееЗначение : double
}

class Сценарий {
  + название : String
  + активно : boolean
}

class Событие {
  + время : DateTime
  + тип : String
}

enum Роль {
  ВЗРОСЛЫЙ
  РЕБЁНОК
  ТЕХНИК
}

enum Состояние {
  ВКЛ
  ВЫКЛ
  ОШИБКА
}

' Связи
Пользователь "1" -- "0..*" Сценарий : настраивает
Сценарий "1" o-- "1..*" Устройство : управляет
Устройство "1" *-- "0..*" Датчик : содержит
Событие "0..*" -- "1" Устройство : фиксируется
Пользователь -- Роль
Устройство -- Состояние

@enduml