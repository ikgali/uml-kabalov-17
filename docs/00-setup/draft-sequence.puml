@startuml
!include ../../_style.puml
title Умный дом — черновик диаграммы последовательности

actor "Жилец" as user
participant "Телеграм-бот" as tg
participant "Пятница" as friday
participant "Контроллер" as ctrl
database "Журнал" as log

user -> tg : «Включи свет в гостиной»
tg -> friday : команда: light_on, room=living
friday -> ctrl : распознанная команда
ctrl -> ctrl : проверить права
ctrl -> log : записать событие
ctrl --> friday : подтверждение
friday --> tg : «Свет включён»
tg --> user : сообщение

@enduml