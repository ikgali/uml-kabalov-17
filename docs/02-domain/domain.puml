@startuml
!include ../../_style.puml
title Умный дом — модель предметной области
hide circle

package "access" {
  abstract class Пользователь {
    + id : String
    + имя : String
    + роль : Роль
    {abstract} + максимальнаяПривилегия() : int
  }
  class Жилец {
    + квартира : String
  }
  class Техник {
    + компания : String
  }
  class ПолитикаДоступа {
    + минимальнаяРоль : Роль
    + разрешить(п : Пользователь, к : Команда) : boolean
  }
  class ЗапросЭскалации {
    + длительность : int
    + статус : СтатусЭскалации
    + одобрить() : void
    + истечь() : void
  }
  enum Роль {
    ВЗРОСЛЫЙ
    РЕБЁНОК
    ТЕХНИК
  }
  enum СтатусЭскалации {
    ЗАПРОШЕН
    ОДОБРЕН
    ИСТЁК
  }
}

package "devices" {
  abstract class Устройство {
    + id : String
    + название : String
    + расположение : String
    + вид : ВидУстройства
    + состояние : Состояние
  }
  class УправляемоеУстройство {
    + выполнитьКоманду(к : Команда) : void
  }
  class Датчик {
    + последнееЗначение : double
    + времяПоследнегоСигнала : DateTime
    + опубликоватьПоказание() : void
  }
  enum ВидУстройства {
    СВЕТ
    ЗАМОК
    КЛИМАТ
    ДАТЧИК_ПРОТЕЧКИ
    ДАТЧИК_ДВИЖЕНИЯ
  }
  enum Состояние {
    ВКЛ
    ВЫКЛ
    ОШИБКА
    ОФЛАЙН
  }
}

package "automation" {
  class Команда {
    + создана : DateTime
    + подтверждена : boolean
    + распознать() : void
    + отклонить(причина : String) : void
  }
  class Сценарий {
    + название : String
    + активно : boolean
    + активировать() : void
    + деактивировать() : void
  }
  class Событие {
    + время : DateTime
    + тип : ТипСобытия
    + описание : String
  }
  class Уведомление {
    + сформировано : DateTime
    + доставлено : DateTime
    + отправить() : void
    + подтвердить() : void
  }
  class Канал {
    + адрес : String
    + резервный : boolean
  }
  class Журнал {
    + создать() : void
    + очистить() : void
  }
  enum ТипСобытия {
    ШТАТНОЕ
    АВАРИЙНОЕ
  }
}

' --- Обобщение ---
Жилец --|> Пользователь
Техник --|> Пользователь
УправляемоеУстройство --|> Устройство
Датчик --|> Устройство

' --- Композиция ---
Журнал "1" *-- "0..*" Событие : содержит >

' --- Агрегация ---
Сценарий "1" o-- "1..*" Устройство : управляет >

' --- Ассоциации ---
Пользователь "1" -- "0..*" ЗапросЭскалации : инициирует >
Пользователь "1" -- "1" ПолитикаДоступа : имеет >
Пользователь "1" -- "0..*" Команда : отправляет >
Команда "0..*" -- "1" Устройство : адресована >
Событие "0..*" -- "0..1" Устройство : источник >
Уведомление "1" -- "1" Канал : доставляется >
Уведомление "1" -- "0..1" Событие : о событии >

' --- Зависимости между пакетами ---
ПолитикаДоступа ..> Команда : <<use>>
Уведомление ..> Пользователь : <<use>>

@enduml