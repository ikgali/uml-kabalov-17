@startuml
!include ../../_style.puml
title Умный дом — модель предметной области
hide circle

package "access" {
  abstract class Пользователь {
    + id : String
    + имя : String
    + роль : Роль
    {abstract} + максимальнаяПривилегия() : int
  }
  class Жилец {
    + квартира : String
  }
  class Техник {
    + компания : String
  }
  class ПолитикаДоступа {
    + минимальнаяРоль : Роль
    + разрешить(п : Пользователь, к : Команда) : boolean
  }
  class ЗапросЭскалации {
    + длительность : int
    + статус : СтатусЭскалации
    + одобрить() : void
    + истечь() : void
  }
  enum Роль {
    ВЗРОСЛЫЙ
    РЕБЁНОК
    ТЕХНИК
  }
  enum СтатусЭскалации {
    ЗАПРОШЕН
    ОДОБРЕН
    ИСТЁК
  }
}

package "devices" {
  abstract class Устройство {
    + id : String
    + название : String
    + расположение : String
    + вид : ВидУстройства
    + состояние : Состояние
  }
  class УправляемоеУстройство {
    + проверитьДоступность() : boolean
    + выполнитьКоманду(к : Команда) : void
  }
  class Датчик {
    + последнееЗначение : double
    + времяПоследнегоСигнала : DateTime
    + опубликоватьПоказание() : void
  }
  enum ВидУстройства {
    СВЕТ
    ЗАМОК
    КЛИМАТ
    ДАТЧИК_ПРОТЕЧКИ
    ДАТЧИК_ДВИЖЕНИЯ
    ДАТЧИК_ДЫМА
  }
  enum Состояние {
    ВКЛ
    ВЫКЛ
    ОШИБКА
    ОФЛАЙН
  }
}

package "automation" {
  class Контроллер {
    + обработатьКоманду(текст : String) : Команда
    + активироватьСценарий(с : Сценарий) : void
    + обработатьСобытие(с : Событие) : void
    + отправитьУведомление(текст : String) : void
    + открытьДвери() : void
  }
  class Команда {
    + создана : DateTime
    + статус : СтатусКоманды
    + распознать() : void
    + отклонить(причина : String) : void
    + подтвердить() : void
  }
  class Сценарий {
    + название : String
    + статус : СтатусСценария
    + активировать() : void
    + деактивировать() : void
    + проверить() : void
    + приостановить() : void
    + возобновить() : void
    + архивировать() : void
  }
  class Событие {
    + время : DateTime
    + тип : ТипСобытия
    + описание : String
  }
  class Уведомление {
    + сформировано : DateTime
    + доставлено : DateTime
    + отправить() : void
    + подтвердить() : void
  }
  class Канал {
    + адрес : String
    + резервный : boolean
  }
  class Журнал {
    + записать(событие : Событие) : void
    + создать() : void
    + очистить() : void
  }
  enum ТипСобытия {
    ШТАТНОЕ
    АВАРИЙНОЕ
  }
  enum СтатусКоманды {
    СОЗДАНА
    РАСПОЗНАНА
    ПРОВЕРЕНА
    ОТПРАВЛЕНА
    ПОДТВЕРЖДЕНА
    ОТКЛОНЕНА
    ОШИБКА
  }
  enum СтатусСценария {
    ЧЕРНОВИК
    НА_ПРОВЕРКЕ
    ГОТОВ_К_АКТИВАЦИИ
    АКТИВИРУЕТСЯ
    АКТИВЕН
    ПРИОСТАНОВЛЕН
    СРАБОТАЛ
    ОТКЛЮЧЁН
    ОШИБКА
    АРХИВИРОВАН
    ЭВАКУАЦИЯ
  }
}

note bottom of Контроллер
  Центральный контроллер — граница системы.
  Добавлен в ПР2: в ПР1 он упоминался в рефлексии,
  но отсутствовал в модели классов.
end note

' --- Обобщение ---
Жилец --|> Пользователь
Техник --|> Пользователь
УправляемоеУстройство --|> Устройство
Датчик --|> Устройство

' --- Композиция ---
Журнал "1" *-- "0..*" Событие : содержит >

' --- Агрегация ---
Сценарий "1" o-- "1..*" Устройство : управляет >

' --- Ассоциации ---
Контроллер "1" -- "0..*" Команда : обрабатывает >
Контроллер "1" -- "0..*" Сценарий : активирует >
Контроллер "1" -- "1" Журнал : ведёт >
Контроллер "1" -- "0..*" Уведомление : формирует >
Пользователь "1" -- "0..*" ЗапросЭскалации : инициирует >
Пользователь "1" -- "1" ПолитикаДоступа : имеет >
Пользователь "1" -- "0..*" Команда : отправляет >
Команда "0..*" -- "1" Устройство : адресована >
Событие "0..*" -- "0..1" Устройство : источник >
Уведомление "1" -- "1" Канал : доставляется >
Уведомление "1" -- "0..1" Событие : о событии >

' --- Зависимости между пакетами ---
Контроллер ..> ПолитикаДоступа : <<use>>
ПолитикаДоступа ..> Команда : <<use>>
Уведомление ..> Пользователь : <<use>>

@enduml
