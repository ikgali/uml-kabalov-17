@startuml
!include ../../_style.puml
title Поток объекта «Сценарий» при активации режима «Никого нет»

start
:Создать сценарий;
:Сценарий [Черновик]; <<object>>
:Проверить сценарий;
:Сценарий [НаПроверке]; <<object>>

if (Проверка пройдена?) then (нет)
  :Сценарий [Ошибка]; <<object>>
  :Зафиксировать ошибку;
  stop
else (да)
  :Сценарий [ГотовКАктивации]; <<object>>
endif

:Активировать сценарий;
:Сценарий [Активируется]; <<object>>
:Применить действия;

if (Устройства доступны?) then (нет)
  :Сценарий [Ошибка]; <<object>>
  :Зафиксировать сбой;
  stop
else (да)
  :Сценарий [Активен]; <<object>>
endif

if (Пожар?) then (да)
  :Сценарий [Эвакуация]; <<object>>
  :Открыть двери;
  :Зафиксировать эвакуацию;
  stop
endif

if (Нужна пауза?) then (да)
  :Сценарий [Приостановлен]; <<object>>
  :Возобновить сценарий;
  :Сценарий [Активен]; <<object>>
endif

:Сработал триггер;
:Сценарий [Сработал]; <<object>>
:Выполнить действия;
:Сценарий [Активен]; <<object>>
:Деактивировать сценарий;
:Сценарий [Отключён]; <<object>>
:Архивировать сценарий;
:Сценарий [Архивирован]; <<object>>
stop
@enduml
